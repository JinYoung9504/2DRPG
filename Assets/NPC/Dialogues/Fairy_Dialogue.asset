  m_Script: {fileID: 11500000, guid: 0b9461bd2d3c90941a3a807808e4542a, type: 3}
  m_Name: Fairy_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  seriaName: "\uC138\uB9AC\uC544"
  seriaPortrait: {fileID: 21300000, guid: 160263b239bfdf24ca86e30a94a42e07, type: 3}
  lines:
  - speaker: 0
    text: "!!! \uB204\uAD6C\uC2DC\uC8E0?"
  - speaker: 1
    text: "\uC694...\uC815? \uC544 \uC800\uB294 \uC2DC\uC791\uC758 \uB9C8\uC744\uC5D0\uC11C
      \uC628 \uC138\uB9AC\uC544\uB77C\uACE0 \uD569\uB2C8\uB2E4."
  - speaker: 1
    text: "\uC774\uC7A5\uB2D8\uC758 \uC694\uCCAD\uC73C\uB85C \uBAAC\uC2A4\uD130\uB4E4\uC744
      \uD1A0\uBC8C\uD558\uACE0 \uC788\uC5B4\uC694."
  - speaker: 0
    text: "\uC138\uB9AC\uC544.... \uADF8\uB7EC\uBA74 \uC800\uB3C4 \uB3C4\uC640\uC918\uC694.
      \uC800\uB97C \uC81C\uC678\uD55C \uC815\uB839\uB4E4\uC774 \uB0A0\uB6F0\uACE0
      \uC788\uC5B4\uC694."
  - speaker: 0
    text: "\uC774\uB4E4\uC744 \uC81C\uC555\uD574\uC11C \uC232\uC744 \uC548\uC815\uD654
      \uC2DC\uCF1C\uC8FC\uC138\uC694."
  - speaker: 1
    text: "\uB124 \uAE30\uC0AC\uC758 \uBA85\uC608\uB97C \uAC78\uACE0 \uC81C\uC555\uD560\uAED8\uC694!"
