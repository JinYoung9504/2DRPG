--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 95a51cdc9037ed64181a81dbffc2341c, type: 3}
  m_Name: Prologue
  m_EditorClassIdentifier: Assembly-CSharp::PrologueData
  charsPerSecond: 22
  lines:
  - speaker: 
    text: "\uC624\uB798\uC804, \uC774 \uB545\uC5D0\uB294 \uC655\uAD6D\uC758 \uC774\uB984\uC73C\uB85C
      \uC138\uC0C1\uC744 \uC9C0\uD0A4\uB358 \uAE30\uC0AC\uB4E4\uC774 \uC788\uC5C8\uB2E4."
  - speaker: 
    text: "\uADF8\uB7EC\uB098 \uBD89\uC740 \uB2EC\uC774 \uB72C \uC5B4\uB290 \uBC24,\n\uD55C
      \uAE30\uC0AC\uAC00 \uC5B4\uB460\uACFC \uACC4\uC57D\uC744 \uB9FA\uC5C8\uB2E4."
  - speaker: 
    text: "\uADF8 \uAE30\uC0AC\uB85C \uC778\uD574 \uC655\uAD6D\uC740 \uD558\uB8FB\uBC24
      \uC0AC\uC774\uC5D0 \uBB34\uB108\uC84C\uACE0,\n\uC131\uC740 \uC8FD\uC740 \uC790\uB4E4\uC758
      \uAC83\uC774 \uB418\uC5C8\uB2E4."
  - speaker: 
    text: "\uADF8\uB85C\uBD80\uD130 \uC2ED \uB144.\n\uBCC0\uBC29\uC758 \uC791\uC740
      \uB9C8\uC744\uC5D0\uC11C, \uD55C \uC18C\uB140\uAC00 \uB098\uD0C0\uB0AC\uB2E4."
  - speaker: "\uC138\uB9AC\uC544"
    text: "\u2026\uB610 \uADF8 \uAFC8\uC774\uC57C.\n\uBD89\uC740 \uB2EC, \uBB34\uB108\uC9C0\uB294
      \uC131, \uADF8\uB9AC\uACE0\u2026 \uB098\uB97C \uBD80\uB974\uB358 \uBAA9\uC18C\uB9AC."
  - speaker: "\uC138\uB9AC\uC544"
    text: "\uC694\uC998 \uB9C8\uC744 \uADFC\uCC98\uAE4C\uC9C0 \uB9C8\uBB3C\uC774
      \uB0B4\uB824\uC624\uACE0 \uC788\uC5B4.\n\uB354 \uC774\uC0C1 \uAC00\uB9CC\uD788
      \uC788\uC744 \uC21C \uC5C6\uC5B4."
  - speaker: "\uC138\uB9AC\uC544"
    text: "\uBA3C\uC800 \uC774\uC7A5\uB2D8\uAED8 \uAC00 \uBCF4\uC790."
  - speaker: 
    text: "\uADF8\uB807\uAC8C, \uC138\uB9AC\uC544\uC758 \uC5EC\uC815\uC774 \uC2DC\uC791\uB418\uC5C8\uB2E4."
