  m_Script: {fileID: 11500000, guid: 57bb088275ef3bb49b9f331f1dfb9a44, type: 3}
  m_Name: VampireBoss
  m_EditorClassIdentifier: Assembly-CSharp::MonsterTalkData
  monsterName: "\uBC40\uD30C\uC774\uC5B4"
  portrait: {fileID: 21300000, guid: 9c104e6d77dd66240a288f0ce9b90034, type: 3}
  sightRange: 11
  onSight:
  - speaker: 0
    text: "(\uC608\uC2DC) \uC774 \uC131\uC5D0 \uC544\uC9C1\uB3C4 \uC0B0 \uC790\uC758
      \uD53C \uB0C4\uC0C8\uAC00 \uB098\uB2E4\uB2C8\u2026 \uC624\uB79C\uB9CC\uC774\uAD70."
    face: {fileID: 21300000, guid: 4e3c3fe4c8484714cb28f10cad962e12, type: 3}
  - speaker: 1
    text: "(\uC608\uC2DC) \uB2F9\uC2E0\uC774\u2026 \uC774 \uC131\uC744 \uC774\uB807\uAC8C
      \uB9CC\uB4E0 \uAC70\uC57C?"
    face: {fileID: 0}
  - speaker: 0
    text: "(\uC608\uC2DC) \uD6C4\uD6C4\u2026 \uADF8 \uD53C, \uD55C \uBC29\uC6B8\uB3C4
      \uB0A8\uAE40\uC5C6\uC774 \uB9C8\uC154\uC8FC\uC9C0."
    face: {fileID: 21300000, guid: 10fc046f19ba05844b783d37884bccf2, type: 3}
  onDefeat:
  - speaker: 0
    text: "(\uC608\uC2DC) \uD06C\uC73D\u2026 \uC774 \uBAB8\uC774\u2026 \uC778\uAC04
      \uB530\uC704\uC5D0\uAC8C\u2026"
    face: {fileID: 21300000, guid: 1a110d696a1be874bbfea7373ad52063, type: 3}
  - speaker: 1
    text: "(\uC608\uC2DC) \uB05D\uB0AC\uC5B4. \uC774\uC81C \uC774 \uC131\uB3C4 \uC274
      \uC218 \uC788\uC744 \uAC70\uC57C."
    face: {fileID: 0}
  oncePerGame: 0
