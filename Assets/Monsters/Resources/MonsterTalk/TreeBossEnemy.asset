  monsterName: "\uD0C0\uB77D\uD55C \uAC70\uB300 \uB098\uBB34\uC815\uB839"
  portrait: {fileID: 21300000, guid: 8f6320eafb41f074583a92a9729aa716, type: 3}
  sightRange: 10
  onSight:
  - speaker: 0
    text: "\u2026\uB204\uAC00\u2026 \uC232\uC758 \uC7A0\uC744 \uAE68\uC6B0\uB294\uAC00\u2026"
    face: {fileID: 0}
  - speaker: 1
    text: "\uC774\uAC8C\u2026 \uC232\uC744 \uC9C0\uD0A4\uB358 \uC815\uB839\uC774\uB77C\uACE0?"
    face: {fileID: 0}
  - speaker: 0
    text: "\uBFCC\uB9AC\uAC00\u2026 \uBAA8\uB4E0 \uAC83\uC744\u2026 \uC0BC\uD0A4\uB9AC\uB77C\u2026!"
    face: {fileID: 0}
  onDefeat:
  - speaker: 0
    text: "\uC544\uC544\u2026 \uC774\uC81C\uC57C\u2026 \uC232\uC758 \uBAA9\uC18C\uB9AC\uAC00\u2026
      \uB4E4\uB9AC\uB294\uAD6C\uB098\u2026"
    face: {fileID: 0}
  - speaker: 1
    text: "(\uC608\uC2DC) \u2026\uD3B8\uD788 \uC26C\uC5B4."
